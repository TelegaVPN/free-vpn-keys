{
  "outbounds": [
    {
      "default": "Auto-Best",
      "outbounds": [
        "Auto-Best",
        "direct"
      ],
      "tag": "proxy",
      "type": "selector"
    },
    {
      "interval": "300s",
      "outbounds": [
        "direct"
      ],
      "tag": "Auto-Best",
      "tolerance": 50,
      "type": "urltest",
      "url": "https://cp.cloudflare.com/generate_204"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    },
    {
      "tag": "dns-out",
      "type": "dns"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "proxy",
    "rules": [
      {
        "outbound": "dns-out",
        "protocol": "dns"
      },
      {
        "geoip": [
          "private"
        ],
        "outbound": "direct"
      },
      {
        "geosite": [
          "category-ru"
        ],
        "outbound": "direct"
      },
      {
        "geoip": [
          "ru"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          ".ru",
          ".su",
          ".xn--p1ai",
          "yandex.ru",
          "yandex.net",
          "ya.ru",
          "vk.com",
          "vk.ru",
          "ok.ru",
          "mail.ru",
          "sberbank.ru",
          "sber.ru",
          "tbank.ru",
          "tinkoff.ru",
          "gosuslugi.ru",
          "mos.ru",
          "kinopoisk.ru",
          "dzen.ru"
        ],
        "outbound": "direct"
      }
    ]
  }
}